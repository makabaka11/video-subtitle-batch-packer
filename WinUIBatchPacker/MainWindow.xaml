<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WinUIBatchPacker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:WinUIBatchPacker" Title="视频字幕批量封装工具（WinUI）">
  <Grid Margin="14" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="760"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <TextBlock Text="视频字幕批量封装" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="C# / .NET · WinUI 3" Opacity="0.65"/>
        <TextBox x:Name="FfmpegBox" Header="FFmpeg 路径（已加入 PATH 可留空）" PlaceholderText="ffmpeg 或选择 ffmpeg.exe"/>
        <Button Content="选择 FFmpeg" Click="PickFfmpeg_Click"/>
        <CheckBox x:Name="SameFolderCheck" Content="视频和字幕散放在同一个文件夹" Checked="FolderModeChanged" Unchecked="FolderModeChanged"/>
        <Grid x:Name="SeparateFoldersPanel" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="8"><TextBox x:Name="VideoFolderBox" Header="视频文件夹" TextChanged="FolderTextChanged"/><TextBox x:Name="SubtitleFolderBox" Header="字幕文件夹" TextChanged="FolderTextChanged"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="20" Margin="0,25,0,0"><Button Content="浏览" Click="PickVideoFolder_Click"/><Button Content="浏览" Click="PickSubtitleFolder_Click"/></StackPanel>
        </Grid>
        <Grid x:Name="InputFolderPanel" Visibility="Collapsed" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="InputFolderBox" Header="输入文件夹" TextChanged="FolderTextChanged"/><Button Grid.Column="1" Content="浏览" Margin="0,25,0,0" Click="PickInputFolder_Click"/>
        </Grid>
        <CheckBox x:Name="ReplaceCheck" Content="成功后用新视频替换原视频（安全临时文件）" Checked="ReplaceModeChanged" Unchecked="ReplaceModeChanged"/>
        <Grid x:Name="OutputFolderPanel" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="OutputFolderBox" Header="输出文件夹"/><Button Grid.Column="1" Content="浏览" Margin="0,25,0,0" Click="PickOutputFolder_Click"/>
        </Grid>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <ComboBox x:Name="EncodingBox" Header="字幕编码" SelectedIndex="0"><ComboBoxItem Content="UTF-8"/><ComboBoxItem Content="gbk"/><ComboBoxItem Content="cp936"/><ComboBoxItem Content="gb2312"/><ComboBoxItem Content="big5"/></ComboBox>
          <ComboBox x:Name="LanguageBox" Grid.Column="1" Header="未知后缀语言" SelectedIndex="0"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="繁体中文"/><ComboBoxItem Content="英语"/></ComboBox>
        </Grid>
        <CheckBox x:Name="DefaultSubtitleCheck" Content="把新增的第一条字幕设为默认"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="开始批量封装" Click="StartPack_Click"/><Button Content="清空日志" Click="ClearLog_Click"/></StackPanel>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1"/>
        <TextBox x:Name="LogBox" Header="执行日志" Height="240" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Column="1" ColumnSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Grid.ColumnSpan="2" Text="已勾选条目按显示序号一一配对；拖动条目可调整顺序。" Margin="0,0,0,8"/>
      <local:MediaListView x:Name="VideoList" Grid.Row="1" HeaderText="视频文件" SelectionChangedByCheck="ListCheckChanged" Reordered="ListReordered"/>
      <local:MediaListView x:Name="SubtitleList" Grid.Row="1" Grid.Column="1" HeaderText="字幕组（同集 sc/tc 合并）" SelectionChangedByCheck="ListCheckChanged" Reordered="ListReordered"/>
      <InfoBar x:Name="MatchInfo" Grid.Row="2" Grid.ColumnSpan="2" IsOpen="True" IsClosable="False" Severity="Informational" Message="请选择输入路径" Margin="0,8,0,0"/>
    </Grid>
  </Grid>
</Window>
