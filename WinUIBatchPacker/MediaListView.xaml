<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="WinUIBatchPacker.MediaListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WinUIBatchPacker">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Padding="8,4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="序号" HorizontalAlignment="Center"/><CheckBox x:Name="SelectAllCheck" Grid.Column="1" Content="全选" IsChecked="True" Click="SelectAll_Click"/><TextBlock x:Name="HeaderBlock" Grid.Column="2"/>
    </Grid>
    <ListView x:Name="RowsList" Grid.Row="1" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="RowsList_DragItemsCompleted" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListView.ItemsPanel>
      <ListView.ItemTemplate><DataTemplate><Grid MinWidth="850" ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"/><CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="ItemCheckBox_Click"/><TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
      </Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="4"><Button Content="↑ 上移" Click="Up_Click"/><Button Content="↓ 下移" Click="Down_Click"/></StackPanel>
  </Grid>
</UserControl>
